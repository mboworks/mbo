"""Extra development modules."""

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "85d83bc1ee3ab8034d9c40f6900a0753688068b6",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)

bazel_dep(name = "depend_on_what_you_use", version = "1.2.0", dev_dependency = True)

# dwyu 1.1.2 pulls boost@1.83.0.bcr.4, whose BCR MODULE.bazel explicitly
# passes repo_name = None. Bazel 8 rejects None for that string parameter.
single_version_override(
    module_name = "boost",
    patch_strip = 1,
    patches = ["//bazelmod:boost-1.83.0-bazel8.patch"],
    version = "1.83.0.bcr.4",
)

# Reference xxHash for //mbo/hash:hash_differential_test (dev/test only). Used
# directly via http_archive because the BCR module's BUILD file predates
# Bazel 9's rule autoload removal; header-only via XXH_INLINE_ALL. The BUILD
# file lives in //third_party/xxhash.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "xxhash_reference",
    build_file = "//third_party/xxhash:xxhash.BUILD.bazel",
    dev_dependency = True,
    integrity = "sha256-quYI3+ghPf0F2QmldxjvgvMHIsOSNEWD0/OQUMfymoA=",
    strip_prefix = "xxHash-0.8.3",
    urls = ["https://github.com/Cyan4973/xxHash/archive/refs/tags/v0.8.3.tar.gz"],
)
