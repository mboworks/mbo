"""LLVM 23 by default; LLVM 22 with instrumented libc++ for MemorySanitizer."""

bazel_dep(name = "toolchains_llvm", version = "1.12.0")

LLVM_VERSION_MSAN = "22.1.8"

MSAN_LIBCXX_URL = "https://github.com/RealtimeRoboticsGroup/toolchains/releases/download/{v}/libcxx-msan-{v}-x86_64-linux-gnu-ubuntu-22.04.tar.zst"

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain_llvm",
    # Select Apple's native linker and its capabilities together, rather than
    # overriding LLD's executable while retaining LLD-specific feature flags.
    # Unspecified platforms retain the toolchain's bundled LLD default.
    linker = {
        "darwin-aarch64": "auto",
        "darwin-x86_64": "auto",
    },
    llvm_version = "23.1.4",
)

# MSan requires a matching compiler and instrumented C++ standard library.
# Use the same runtime archive as toolchains_llvm's end-to-end MSan test.
llvm.feature_override(
    name = "llvm_toolchain_llvm",
    features = ["msan"],
    libcxx_sha256 = "fd1ac49eeda4edc6deeda2037998e558718a63a5054fff4fdace7751b270217a",
    libcxx_url = MSAN_LIBCXX_URL.format(v = LLVM_VERSION_MSAN),
    llvm_version = LLVM_VERSION_MSAN,
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain_llvm")

# NOTE: We deliberately do NOT `register_toolchains(...)` here. Bazel 9 always
# performs C++ toolchain resolution (the old
# `--[no]incompatible_enable_cc_toolchain_resolution` flag is now a no-op), so an
# unconditionally registered hermetic LLVM toolchain would be selected even for
# the `gcc`/`native` builds that intentionally do NOT pass `--config=clang`,
# silently turning every build into a clang build. Instead the toolchain is
# registered only under `--config=clang` via `--extra_toolchains` in `.bazelrc`,
# which keeps `gcc`/`native` builds on the autodetected local compiler.
