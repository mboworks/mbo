{
  "include": ["mbo/**"],
  "exclude": [
    "mbo/**/*_benchmark.cc",
    "mbo/**/*_fuzz_test.cc",
    "mbo/**/*_test.cc",
    "mbo/**/*_test.h"
  ],
  "minimum": { "lines": 80, "functions": 75, "branches": 80 },
  "target": { "lines": 95, "functions": 95, "branches": 85 },
  "enforce": { "lines": "medium", "functions": "medium", "branches": "high" },
  "baseline": {
    "maximum_drop": { "lines": 0.1, "functions": 0.1, "branches": 0.1 }
  },
  "patch": {
    "minimum": { "lines": 95, "branches": 85 },
    "target": { "lines": 98, "branches": 90 },
    "enforce": "medium"
  },
  "categories": {
    "config": { "include": ["mbo/config/**"] },
    "container": { "include": ["mbo/container/**"] },
    "diff": {
      "include": ["mbo/diff/**"],
      "minimum": { "functions": 60 },
      "reason": "Clang reports template instantiations that GCC coverage did not count."
    },
    "digest": { "include": ["mbo/digest/**"] },
    "file": { "include": ["mbo/file/**"] },
    "hash": { "include": ["mbo/hash/**"] },
    "json": { "include": ["mbo/json/**"] },
    "log": { "include": ["mbo/log/**"] },
    "mope": { "include": ["mbo/mope/**"] },
    "status": { "include": ["mbo/status/**"] },
    "strings": { "include": ["mbo/strings/**"] },
    "testing": { "include": ["mbo/testing/**"] },
    "types": {
      "include": ["mbo/types/**"],
      "minimum": { "lines": 60, "functions": 45 },
      "reason": "Clang reports constexpr and template instantiations that GCC coverage did not count."
    }
  }
}
