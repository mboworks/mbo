load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(
    default_visibility = ["//mbo/diff:__subpackages__"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

cc_library(
    name = "update_absl_log_flags_cc",
    srcs = ["update_absl_log_flags.cc"],
    hdrs = ["update_absl_log_flags.h"],
    visibility = ["//mbo/diff:__pkg__"],
    deps = [
        "@abseil-cpp//absl/flags:commandlineflag",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:reflection",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:flags",
    ],
)

cc_library(
    name = "chunk_cc",
    srcs = ["chunk.cc"],
    hdrs = ["chunk.h"],
    deps = [
        ":context_cc",
        ":output_cc",
        "//mbo/diff:diff_options_cc",
        "//mbo/strings:strip_cc",
        "@abseil-cpp//absl/cleanup",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@re2",
    ],
)

cc_library(
    name = "output_cc",
    srcs = ["output.cc"],
    hdrs = ["output.h"],
    deps = [
        "//mbo/diff:diff_options_cc",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_library(
    name = "context_cc",
    hdrs = ["context.h"],
    deps = [
        "//mbo/diff:diff_options_cc",
        "//mbo/file:artefact_cc",
        "//mbo/strings:strip_cc",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

cc_library(
    name = "data_cc",
    srcs = ["data.cc"],
    hdrs = ["data.h"],
    deps = [
        "//mbo/diff:diff_options_cc",
        "//mbo/file:artefact_cc",
        "//mbo/strings:strip_cc",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@re2",
    ],
)

cc_test(
    name = "diff_internal_test",
    size = "small",
    srcs = ["diff_internal_test.cc"],
    deps = [
        ":chunk_cc",
        ":context_cc",
        ":data_cc",
        ":output_cc",
        ":update_absl_log_flags_cc",
        "//mbo/diff:diff_options_cc",
        "//mbo/testing:matchers_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
