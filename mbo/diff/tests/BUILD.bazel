load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//mbo/diff:diff.bzl", "diff_test")
load(":diff_test_test.bzl", "diff_test_formats_test", "diff_test_test")

package(default_visibility = ["//visibility:private"])

bzl_library(
    name = "diff_test_test_bzl",
    srcs = ["diff_test_test.bzl"],
    visibility = ["//visibility:private"],
    deps = [
        "//mbo/diff:diff_bzl",
        "@bazel_skylib//lib:shell",
    ],
)

diff_test(
    name = "diff_equal_test",
    file_new = "abc.txt",
    file_old = "abc.txt",
)

diff_test_test(
    name = "abc_axc_diff_test",
    expected_diff = "abc_axc.diff.txt",
    file_new = "axc.txt",
    file_old = "abc.txt",
)

diff_test_formats_test(
    name = "abc_axc",
    algorithms = [
        "myers",
        "naive",
    ],
    expected_diffs = {
        "context": "abc_axc_context.diff.txt",
        "normal": "abc_axc_normal.diff.txt",
        "side-by-side": "abc_axc_side_by_side.diff.txt",
        "unified": "abc_axc.diff.txt",
    },
    file_new = "axc.txt",
    file_old = "abc.txt",
)

diff_test_test(
    name = "abc_axc_side_by_side_w40_diff_test",
    expected_diff = "abc_axc_side_by_side_w40.diff.txt",
    file_new = "axc.txt",
    file_old = "abc.txt",
    format = "side-by-side",
    # Proves the bzl plumbing; the output of this trivial input is unaffected.
    minimal = True,
    width = 40,
)

diff_test_test(
    name = "same_unified_diff_test",
    # Exercises the deprecated 'unified' algorithm alias (now called 'naive').
    algorithm = "unified",
    expected_diff = "same_unified.diff.txt",
    file_new = "abc.txt",
    file_old = "abc_same.txt",
)

diff_test_formats_test(
    name = "multi_chunk",
    algorithms = [
        "myers",
        "naive",
    ],
    expected_diffs = {
        "context": "multi_chunk_context.diff.txt",
        "normal": "multi_chunk_normal.diff.txt",
        "side-by-side": "multi_chunk_side_by_side.diff.txt",
        "unified": "multi_chunk_unified.diff.txt",
    },
    file_new = "direct.rhs.txt",
    file_old = "direct.lhs.txt",
)

diff_test_test(
    name = "abc_axc_direct_diff_test",
    algorithm = "direct",
    expected_diff = "abc_axc_direct.diff.txt",
    file_new = "axc.txt",
    file_old = "abc.txt",
)

diff_test_test(
    name = "same_direct_diff_test",
    algorithm = "direct",
    expected_diff = "same_direct.diff.txt",
    file_new = "abc.txt",
    file_old = "abc_same.txt",
)

diff_test(
    name = "diff_ignore_matching_lines_test",
    file_new = "axc.txt",
    file_old = "abc.txt",
    ignore_matching_lines = "[bx]",
)

diff_test(
    name = "abc_comments_equal_test",
    file_new = "abc_comments.txt",
    file_old = "abc.txt",
    strip_comments = "#",
)

diff_test_test(
    name = "abc_axc_comments_diff_test",
    expected_diff = "abc_axc_comments.diff.txt",
    file_new = "axc_comments.txt",
    file_old = "abc.txt",
)

diff_test_formats_test(
    name = "abc_axc_comments_stripped",
    algorithms = [
        "myers",
        "naive",
    ],
    expected_diffs = {"unified": "abc_axc_comments_stripped.diff.txt"},
    file_new = "axc_comments.txt",
    file_old = "abc.txt",
    strip_comments = "#",
)

diff_test(
    name = "abc_ignore_case_diff_test",
    file_new = "abc_caps.txt",
    file_old = "abc.txt",
    ignore_case = True,
)

diff_test_formats_test(
    name = "abc_caps",
    algorithms = [
        "myers",
        "naive",
    ],
    expected_diffs = {"unified": "abc_caps.diff.txt"},
    file_new = "abc_caps.txt",
    file_old = "abc.txt",
)

diff_test_test(
    name = "abc_whitespace_diff_test",
    expected_diff = "abc_whitespace.diff.txt",
    file_new = "abc_whitespace.txt",
    file_old = "abc.txt",
)

diff_test(
    name = "abc_ignore_all_space_diff_test",
    file_new = "abc_no_whitespace.txt",
    file_old = "abc.txt",
    ignore_all_space = True,
)

diff_test(
    name = "abc_ignore_consecutive_space_diff_test",
    file_new = "abc_whitespace.txt",
    file_old = "abc.txt",
    ignore_consecutive_space = True,
)

diff_test_test(
    # The 'c c' is not the same as 'cc' (from `abc_no_whitespace`) if `ignore_consecutive_space` is
    # used as opposed to ignore_all_space. The above case `abc_ignore_consecutive_space_diff_test`
    # works becasue `c c` and `c  c` are the same as the latter with consecutive spaces removed is
    # the same as the former.
    name = "abc_ignore_all_vs_consecutive_space_diff_test",
    expected_diff = "abc_all_vs_consecutive_space.diff.txt",
    file_new = "abc_no_whitespace.txt",
    file_old = "abc.txt",
    ignore_consecutive_space = True,
)

diff_test_test(
    name = "abc_ignore_trailing_space_diff_test",
    expected_diff = "abc_ignore_trailing_space.diff.txt",
    file_new = "abc_whitespace.txt",
    file_old = "abc.txt",
    ignore_trailing_space = True,
)

diff_test(
    name = "numbers_ignore_blank_lines_diff_test",
    file_new = "numbers_blanks.txt",
    file_old = "numbers.txt",
    ignore_blank_lines = True,
)

diff_test_test(
    name = "numbers_blanks_diff_test",
    expected_diff = "numbers_blanks.diff.txt",
    file_new = "numbers_blanks.txt",
    file_old = "numbers.txt",
)

diff_test_test(
    name = "numbers_blanks_plus_diff_test",
    expected_diff = "numbers_blanks_plus.diff.txt",
    file_new = "numbers_blanks_plus.txt",
    file_old = "numbers.txt",
    ignore_blank_lines = True,
)

diff_test_test(
    name = "direct_diff_test",
    algorithm = "direct",
    expected_diff = "direct.diff.txt",
    file_new = "direct.rhs.txt",
    file_old = "direct.lhs.txt",
    show_chunk_headers = False,
)

diff_test_test(
    name = "direct_no_header_diff_test",
    algorithm = "direct",
    expected_diff = "direct.no_header_diff_test.txt",
    file_header_use = "none",
    file_new = "direct.rhs.txt",
    file_old = "direct.lhs.txt",
    show_chunk_headers = False,
)

diff_test_test(
    name = "direct_context_diff_test",
    algorithm = "direct",
    context = 2,
    expected_diff = "direct.context_diff_test.txt",
    file_header_use = "both",
    file_new = "direct.rhs.txt",
    file_old = "direct.lhs.txt",
    show_chunk_headers = True,
)

diff_test_formats_test(
    name = "direct_formats",
    algorithms = ["direct"],
    expected_diffs = {
        "context": "direct_formats_context.diff.txt",
        "normal": "direct_formats_normal.diff.txt",
        "side-by-side": "direct_formats_side_by_side.diff.txt",
        "unified": "direct_formats_unified.diff.txt",
    },
    file_new = "direct.rhs.txt",
    file_old = "direct.lhs.txt",
)
