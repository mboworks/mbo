load("@mboworks_bashtest//bashtest:bashtest.bzl", "bashtest")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_fuzzing//fuzzing:cc_defs.bzl", "cc_fuzz_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "artefact_cc",
    srcs = ["artefact.cc"],
    hdrs = ["artefact.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":file_cc",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/time",
    ],
)

cc_test(
    name = "artefact_test",
    size = "small",
    srcs = ["artefact_test.cc"],
    deps = [
        ":artefact_cc",
        "//mbo/testing:matchers_cc",
        "//mbo/testing:status_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "file_cc",
    srcs = ["file.cc"],
    hdrs = ["file.h"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/time",
    ],
)

cc_test(
    name = "file_test",
    size = "small",
    srcs = ["file_test.cc"],
    deps = [
        ":file_cc",
        "//mbo/testing:matchers_cc",
        "//mbo/testing:status_cc",
        "@abseil-cpp//absl/status",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "glob_cc",
    srcs = ["glob.cc"],
    hdrs = ["glob.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//mbo/status:status_macros_cc",
        "//mbo/strings:split_cc",
        "//mbo/types:extend_cc",
        "//mbo/types:stringify_cc",
        "@abseil-cpp//absl/algorithm",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/container:btree",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@re2",
    ],
)

cc_test(
    name = "glob_test",
    size = "small",
    srcs = ["glob_test.cc"],
    deps = [
        ":glob_cc",
        "//mbo/status:status_macros_cc",
        "//mbo/testing:status_cc",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@re2",
    ],
)

cc_fuzz_test(
    name = "glob_fuzz_test",
    size = "small",
    srcs = ["glob_fuzz_test.cc"],
    deps = [":glob_cc"],
)

cc_binary(
    name = "glob",
    srcs = ["glob_main.cc"],
    deps = [
        ":glob_cc",
        "//mbo/status:status_cc",
        "//mbo/strings:numbers_cc",
        "//mbo/types:extend_cc",
        "@abseil-cpp//absl/container:btree",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

bashtest(
    name = "glob_sh_test",
    size = "small",
    srcs = ["glob_sh_test.sh"],
    data = [":glob"] + glob(["testdata/glob_sh_test/**"]),
)
