load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

alias(
    name = "json",
    actual = "json_cc",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "json_cc",
    hdrs = ["json.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//mbo/config:require_cc",
        "//mbo/container:value_pop_cc",
        "//mbo/types:cases_cc",
        "//mbo/types:compare_cc",
        "//mbo/types:stringify_cc",
        "//mbo/types:traits_cc",
        "//mbo/types:variant_cc",
        "@abseil-cpp//absl/container:flat_hash_map",
    ],
)

cc_test(
    name = "json_test",
    size = "small",
    srcs = ["json_test.cc"],
    deps = [
        ":json_cc",
        "//mbo/testing:matchers_cc",
        "//mbo/types:typed_view_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# Verifies that throwing operations supplied by exception-enabled consumers
# propagate through Json construction.
cc_test(
    name = "json_exception_test",
    size = "small",
    srcs = ["json_exception_test.cc"],
    # Clang on Darwin cannot unwind caught exceptions when ASan and UBSan are
    # combined. Keep ASan, but omit UBSan instrumentation for this narrow test.
    copts = [
        "-fexceptions",
        "-fno-sanitize=undefined",
    ],
    # Exception-enabled compilation adds unwind branches to every inline Json
    # template instantiated by this test, including unrelated comparators. The
    # compatibility test remains in every ordinary matrix but must not distort
    # the production coverage report.
    tags = ["no-coverage"],
    deps = [
        ":json_cc",
        "@googletest//:gtest_main",
    ],
)

# Exercises Json precondition failures in-process so coverage data is flushed.
# This target exists only in the exception-enabled configuration and is invoked
# by the supplemental coverage pass.
cc_test(
    name = "json_require_exceptions_test",
    size = "small",
    srcs = ["json_require_exceptions_test.cc"],
    # Including json.h instantiates unrelated noexcept templates containing
    # configurable requirements. This target does not exercise those paths;
    # their exception specifications require a separate API audit.
    copts = ["-fexceptions"] + select({
        "@rules_cc//cc/compiler:clang": ["-Wno-exceptions"],
        "@rules_cc//cc/compiler:gcc": ["-Wno-terminate"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "//mbo/config:require_throws_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":json_cc",
        "@googletest//:gtest_main",
    ],
)
