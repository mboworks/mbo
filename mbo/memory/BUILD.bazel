load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "block_source_cc",
    hdrs = ["block_source.h"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "block_source_test",
    size = "small",
    srcs = ["block_source_test.cc"],
    deps = [
        ":block_source_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "arena_benchmark",
    testonly = True,
    srcs = ["arena_benchmark.cc"],
    tags = [
        "clang-tidy",
        "manual",
    ],
    deps = [
        ":arena_cc",
        "@com_github_google_benchmark//:benchmark",
    ],
)

cc_binary(
    name = "arena_layout_benchmark",
    testonly = True,
    srcs = ["arena_layout_benchmark.cc"],
    tags = [
        "clang-tidy",
        "manual",
    ],
    deps = [
        ":arena_cc",
        "@com_github_google_benchmark//:benchmark",
    ],
)

# Also exercise the allocator and PMR bad_alloc adapters with exceptions enabled.
# The library's default exception-free build cannot execute those branches.
cc_test(
    name = "block_source_exceptions_test",
    size = "small",
    srcs = ["block_source_test.cc"],
    copts = ["-fexceptions"] + select({
        "@rules_cc//cc/compiler:clang": ["-Wno-exceptions"],
        "//conditions:default": [],
    }),
    deps = [
        ":block_source_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "arena_cc",
    hdrs = ["arena.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":block_source_cc",
        "//mbo/config:require_cc",
    ],
)

cc_test(
    name = "arena_test",
    size = "small",
    srcs = ["arena_test.cc"],
    deps = [
        ":arena_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# Exercises propagation from a throwing consumer-provided BlockSource. Mbo's
# production configuration remains exception-free.
cc_test(
    name = "arena_exceptions_test",
    size = "small",
    srcs = ["arena_exceptions_test.cc"],
    copts = ["-fexceptions"],
    tags = ["no-coverage"],
    deps = [
        ":arena_cc",
        "//mbo/config:config_cc",
        "@googletest//:gtest_main",
    ],
)
