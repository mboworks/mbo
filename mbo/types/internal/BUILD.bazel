load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//mbo/mope:mope.bzl", "mope_test")

package(default_visibility = ["//mbo/types:__pkg__"])

cc_library(
    name = "cases_cc",
    hdrs = ["cases.h"],
)

cc_test(
    name = "cases_internal_test",
    size = "small",
    srcs = ["cases_test.cc"],
    deps = [
        ":cases_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "extender_cc",
    hdrs = ["extender.h"],
    deps = [
        "//mbo/types:traits_cc",
        "//mbo/types:tuple_cc",
    ],
)

cc_library(
    name = "extend_cc",
    hdrs = ["extend.h"],
    deps = [
        ":extender_cc",
        "//mbo/types:extender_cc",
        "//mbo/types:traits_cc",
        "//mbo/types:tuple_cc",
    ],
)

cc_library(
    name = "struct_names_cc",
    srcs = [
        "struct_names_clang.h",
        "struct_names_gcc.h",
    ],
    hdrs = ["struct_names.h"],
    deps = [
        ":traits_cc",
        "//mbo/types:tuple_extras_cc",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "struct_names_test",
    size = "small",
    srcs = ["struct_names_test.cc"],
    deps = [
        ":struct_names_cc",
        "//mbo/types:tstring_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "traits_cc",
    hdrs = [
        "decompose_count.h",
        "is_braces_constructible.h",
        "traits.h",
    ],
    deps = [
        ":cases_cc",
        "//mbo/types:template_search_cc",
    ],
)

cc_test(
    name = "traits_internal_test",
    size = "small",
    srcs = ["traits_test.cc"],
    deps = [
        ":traits_cc",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "test_types_cc",
    testonly = 1,
    hdrs = ["test_types.h"],
    deps = [
        ":cases_cc",
        "@googletest//:gtest",
    ],
)

mope_test(
    name = "decompose_count_test",
    srcs = ["decompose_count.h.mope"],
    outs = ["decompose_count.h"],
    args = [
        # For Clang we can enable OverloadSets. For GCC we have to disable it.
        # We can identifify the compiler with a `#if...` but decide here whether
        # we want to add the Clang specific part at all.
        # See details in mbo/types/internal/decompose_count.h.mope
        "--set=use_clang:enabled,:max_fields=40",
    ],
    clang_format = True,
)

cc_test(
    name = "extend_internal_test",
    size = "small",
    srcs = ["extend_internal_test.cc"],
    deps = [
        ":extend_cc",
        ":extender_cc",
        ":test_types_cc",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
