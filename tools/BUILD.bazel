"""mboworks_mbo/tools"""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "release_consumer",
    srcs = ["release_consumer.cc"],
    deps = [
        "//mbo/container:limited_map_cc",
        "//mbo/container:segmented_deque_cc",
        "//mbo/container:segmented_vector_cc",
        "//mbo/container/experimental:frozen_map_cc",
        "//mbo/container/experimental/hamt:hamt_flat_map_cc",
        "//mbo/strings:string_interner_cc",
        "//mbo/types:string_or_view_cc",
    ],
)

_SYMBOLIZER = "@llvm_toolchain_llvm//:llvm-symbolizer"

# Bake the hermetic llvm-symbolizer's RUNFILES path (an rlocation string) into the
# run-under wrapper under --config=clang; otherwise "auto" (system autodetection).
# A runfiles path stays valid when the LLVM toolchain is re-fetched to a new
# location each run, unlike a `readlink -f` absolute path into the output tree -
# which only survived because CI cached the whole output root, the very thing the
# cache split stops doing.
genrule(
    name = "generate_run_under_script",
    srcs = [":run_under_symbolizer.sh.in"],
    outs = ["run_under_symbolizer.sh"],
    cmd = select({
        "//:is_clang": "sed 's,%%SYMBOLIZER_RLOCATION%%,$(rlocationpath " + _SYMBOLIZER + "),' $< > $@",
        "//conditions:default": "sed 's,%%SYMBOLIZER_RLOCATION%%,auto,' $< > $@",
    }),
    executable = True,
    tags = ["manual"],
    tools = select({
        "//:is_clang": [_SYMBOLIZER],
        "//conditions:default": [],
    }),
)

sh_binary(
    name = "run_under_symbolizer",
    srcs = ["run_under_symbolizer.sh"],
    data = select({
        "//:is_clang": [_SYMBOLIZER],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

cc_binary(
    name = "show_compiler",
    srcs = ["show_compiler.cc"],
    tags = [
        "clang-tidy",
        "manual",
    ],
)
